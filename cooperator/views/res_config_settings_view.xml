<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_cooperator_view_form" model="ir.ui.view">
        <field name="name">Cooperators</field>
        <field name="model">res.config.settings</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    id="cooperator_settings_block"
                    string="Cooperators"
                    data-key="cooperator"
                    groups="cooperator.cooperator_group_user"
                >
                    <!-- Bloque de General Settings -->
                    <block string="General Settings">
                        <setting
                            name="create_user"
                            string="Create users for cooperators"
                            help="Automatically create a portal user for cooperators"
                        />
                        <setting
                            name="unmix_share_type"
                            string="Unmix Share Type"
                            help="Allow unmixing of share types"
                        />
                    </block>

                    <!-- Bloque de Share Capital -->
                    <block string="Share Capital">
                        <setting
                            name="share_product"
                            string="Share Product"
                            help="Product used for share capital"
                        />
                        <setting
                            name="share_min_amount"
                            string="Minimum Share Amount"
                            help="Minimum amount for a share"
                        />
                        <setting
                            name="share_capital_min_amount"
                            string="Minimum Share Capital"
                            help="Minimum share capital for a cooperator"
                        />
                    </block>

                    <!-- Bloque de Share Update Mail Templates -->
                    <block string="Share Update Mail Templates">
                        <setting
                            name="cooperator_share_update_mail_template"
                            string="Custom Email Template"
                            help="Template for share update emails"
                        />
                        <setting
                            name="cooperator_share_update_no_shares_mail_template"
                            string="Custom Email Template With No Remaining Shares"
                            help="Template for share update emails when no shares remain"
                        />
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_cooperator_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'cooperator', 'bin_size': False}</field>
    </record>
</odoo>